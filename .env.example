# Groq — LLM backend
GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs — Voice cloning & TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# API authentication (leave empty for open access in dev)
# Admin key: everything, including the /agent/* draft queue. Never ship it to a browser.
TWIN_API_KEY=your_admin_key
# Public site key: chat endpoints only. Safe to embed in josepeon.co's bundle.
TWIN_PUBLIC_KEY=your_public_site_key

# Model config (defaults shown — override as needed)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512

# Voice
TTS_MODEL=eleven_multilingual_v2
TTS_MODEL_REALTIME=eleven_flash_v2_5

# RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=15

# Memory (optional — defaults to data/personal/memory.db)
# MEMORY_DB_PATH=/app/data/personal/memory/memory.db
