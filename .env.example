# Groq — LLM backend
GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs — Voice cloning & TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# API authentication (leave empty for open access in dev)
TWIN_API_KEY=your_api_key_for_twin_endpoint

# Model config (defaults shown — override as needed)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=qwen/qwen3-32b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=256

# Voice
TTS_MODEL=eleven_multilingual_v2
TTS_MODEL_REALTIME=eleven_flash_v2_5

# RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=15

# Memory (optional — defaults to data/personal/memory.db)
# MEMORY_DB_PATH=/app/data/personal/memory/memory.db
